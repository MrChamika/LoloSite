---
// Portfolio / Industry Showcase Section
const industries = [
  { name: 'Wellness & Clinics', category: 'Health & Spa', image: '/LoloSite/showcase-wellness.webp', mobileImage: '/LoloSite/showcase-wellness-mobile.webp' },
  { name: 'Hair Salons & Stylists', category: 'Beauty', image: '/LoloSite/showcase-salon.webp', mobileImage: '/LoloSite/showcase-salon-mobile.webp' },
  { name: 'Talent & Staffing', category: 'Recruitment', image: '/LoloSite/showcase-recruitment.webp', mobileImage: '/LoloSite/showcase-recruitment-mobile.webp' },
  { name: 'Schools & Education', category: 'Education', image: '/LoloSite/showcase-education.webp', mobileImage: '/LoloSite/showcase-education-mobile.webp' },
  { name: 'Cosmetics & Beauty', category: 'E-Commerce', image: '/LoloSite/showcase-beauty.webp', mobileImage: '/LoloSite/showcase-beauty-mobile.webp' },
  { name: 'Dealers & Services', category: 'Automotive', image: '/LoloSite/showcase-automotive.webp', mobileImage: '/LoloSite/showcase-automotive-mobile.webp' },
  { name: 'Mobility & Connectivity', category: 'Travel & Telecom', image: '/LoloSite/showcase-travel.webp', mobileImage: '/LoloSite/showcase-travel-mobile.webp' },
  { name: 'Build & Trades', category: 'Construction', image: '/LoloSite/showcase-construction.webp', mobileImage: '/LoloSite/showcase-construction-mobile.webp' },
];
---

<section id="portfolio" class="py-24 md:py-32 bg-white">
  <div class="max-w-7xl mx-auto px-6 md:px-12 mb-12">
    <div class="text-center css-reveal">
      <p class="text-sm font-accent text-coral tracking-widest uppercase mb-2">Portfolio</p>
      <h2 class="text-3xl md:text-4xl font-heading font-bold text-warm-800 mb-4">Built for every business</h2>
      <p class="text-warm-600 max-w-2xl mx-auto">
        Real projects for real businesses, from healthcare to e-commerce and everything in between.
      </p>
    </div>
  </div>

  <div class="max-w-7xl mx-auto px-6 md:px-12">
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
      {industries.map((industry, i) => (
        <div class="industry-card group relative overflow-hidden rounded-2xl aspect-[4/5] cursor-pointer css-reveal" style={`transition-delay: ${i * 60}ms`}>
          <picture>
            <source media="(max-width: 767px)" srcset={industry.mobileImage} />
            <source media="(min-width: 768px)" srcset={industry.image} />
            <img src={industry.image} alt={industry.name} class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" loading="lazy" />
          </picture>
          <div class="absolute inset-0 bg-gradient-to-t from-black/70 via-black/20 to-transparent"></div>
          <div class="absolute bottom-0 left-0 right-0 p-5">
            <p class="text-xs font-accent text-coral tracking-widest uppercase mb-1">{industry.category}</p>
            <h3 class="text-lg font-heading font-bold text-white">{industry.name}</h3>
          </div>
          <div class="absolute top-4 right-4 w-8 h-8 bg-white/20 backdrop-blur-sm rounded-full flex items-center justify-center opacity-0 group-hover:opacity-100 transition-opacity">
            <svg class="w-4 h-4 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/>
            </svg>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>