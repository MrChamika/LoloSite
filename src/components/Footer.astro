---
// Footer Component
const currentYear = new Date().getFullYear();

const quickLinks = [
  { name: 'Home', href: '#hero' },
  { name: 'About', href: '#about' },
  { name: 'Portfolio', href: '#portfolio' },
  { name: 'Case Studies', href: '#portfolio' },
  { name: 'Journal', href: '#' },
  { name: 'Contact', href: '#contact' },
];

const services = [
  { name: 'Website Development', href: '#contact' },
  { name: 'App Development', href: '#contact' },
  { name: 'Systems & Platforms', href: '#contact' },
  { name: 'AI Media & Content', href: '#contact' },
];

const socials = [
  { name: 'Facebook', href: 'https://www.facebook.com/lorolabs', icon: 'M18 2h-3a5 5 0 00-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 011-1h3z' },
  { name: 'Instagram', href: 'https://www.instagram.com/lorolabs.ai', icon: 'M16 11.37A4 4 0 1112.63 8 4 4 0 0116 11.37zm1.5-4.87h.01M6.5 3h11A3.5 3.5 0 0121 6.5v11a3.5 3.5 0 01-3.5 3.5h-11A3.5 3.5 0 013 17.5v-11A3.5 3.5 0 016.5 3z' },
  { name: 'TikTok', href: 'https://www.tiktok.com/@lorolabs', icon: 'M19.59 6.69a4.83 4.83 0 01-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 01-2.88 2.5 2.89 2.89 0 01-2.89-2.89 2.89 2.89 0 012.89-2.89c.28 0 .54.04.79.1v-3.5a6.37 6.37 0 00-.79-.05A6.34 6.34 0 003.15 15.2a6.34 6.34 0 0010.86 4.48V13.2a8.16 8.16 0 005.58 2.17v-3.45a4.85 4.85 0 01-5.58-2.77V6.69h5.58z' },
  { name: 'LinkedIn', href: 'https://ph.linkedin.com/company/loro-labs', icon: 'M16 8a6 6 0 016 6v7h-4v-7a2 2 0 00-2-2 2 2 0 00-2 2v7h-4v-7a6 6 0 016-6zM2 9h4v12H2zM4 2a2 2 0 110 4 2 2 0 010-4z' },
  { name: 'Dribbble', href: 'https://dribbble.com/lorolabs', icon: 'M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm6.605 4.61a8.502 8.502 0 011.93 5.314c-.281-.054-3.101-.629-5.943-.271-.065-.141-.12-.293-.184-.445a25.416 25.416 0 00-.564-1.236c3.145-1.28 4.577-3.124 4.761-3.362zM12 3.475c2.17 0 4.154.813 5.662 2.148-.152.216-1.443 1.941-4.48 3.08-1.399-2.57-2.95-4.675-3.189-5A8.687 8.687 0 0112 3.475zm-3.633.803a53.896 53.896 0 013.167 4.935c-3.992 1.063-7.517 1.04-7.896 1.04a8.581 8.581 0 014.729-5.975zM3.453 12.01v-.26c.37.01 4.512.065 8.775-1.215.245.477.477.965.694 1.453-.109.033-.228.065-.336.098-4.404 1.42-6.747 5.303-6.942 5.629a8.522 8.522 0 01-2.19-5.705zM12 20.547a8.482 8.482 0 01-5.239-1.8c.152-.315 1.888-3.656 6.703-5.337.022-.01.033-.01.054-.022a35.318 35.318 0 011.823 6.475 8.4 8.4 0 01-3.341.684zm4.761-1.465c-.086-.52-.542-3.015-1.659-6.084 2.679-.423 5.022.271 5.314.369a8.468 8.468 0 01-3.655 5.715z' },
  { name: 'GitHub', href: 'https://github.com/lorolabs-ai', icon: 'M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 00-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0020 4.77 5.07 5.07 0 0019.91 1S18.73.65 16 2.48a13.38 13.38 0 00-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 005 4.77a5.44 5.44 0 00-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 009 18.13V22' },
  { name: 'Clutch', href: 'https://clutch.co/profile/loro-labs', icon: 'M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 15l-5-5 1.41-1.41L10 14.17l7.59-7.59L19 8l-9 9z' },
];
---

<footer class="bg-[#0a0a0a] text-white pt-20 pb-8 rounded-t-3xl">
  <div class="max-w-7xl mx-auto px-6 md:px-12">
    <!-- Top Row: Brand + Quick Links -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-12 mb-16">
      <!-- Brand Column -->
      <div>
        <a href="#hero" class="mb-6 inline-block group">
          <span class="font-heading font-bold text-4xl tracking-tight group-hover:opacity-80 transition-opacity">loro</span>
        </a>
        <p class="text-white/60 text-sm leading-relaxed mb-6 max-w-xs">
          We build websites that convert, apps that scale, and brands people remember.
        </p>
        <!-- Social Links -->
        <div class="flex gap-4">
          {socials.map(social => (
            <a href={social.href} target="_blank" rel="noopener noreferrer" class="footer-social text-white/50 hover:text-white transition-colors">
              <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
                <path d={social.icon}/>
              </svg>
            </a>
          ))}
        </div>
      </div>

      <!-- Quick Links Column -->
      <div>
        <h4 class="font-heading font-semibold text-white mb-4 uppercase text-sm tracking-wider">Quick Links</h4>
        <ul class="space-y-3">
          {quickLinks.map(link => (
            <li>
              <a href={link.href} class="text-white/60 text-sm hover:text-coral transition-colors">{link.name}</a>
            </li>
          ))}
        </ul>
      </div>
    </div>

    <!-- Bottom Row: Services + Contact -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-12 mb-16">
      <!-- Services Column -->
      <div>
        <h4 class="font-heading font-semibold text-white mb-4 uppercase text-sm tracking-wider">Services</h4>
        <ul class="space-y-3">
          {services.map(service => (
            <li>
              <a href={service.href} class="text-white/60 text-sm hover:text-coral transition-colors">{service.name}</a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Contact Column -->
      <div>
        <h4 class="font-heading font-semibold text-white mb-4 uppercase text-sm tracking-wider">Studio & Contact</h4>
        <p class="text-coral text-xs mb-4 font-accent uppercase tracking-wider">Loro Labs Technologies</p>
        <div class="space-y-3 text-sm text-white/60">
          <a href="https://maps.google.com" class="flex items-start gap-2 hover:text-coral transition-colors">
            <svg class="w-4 h-4 mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
            <span>Unit 111 Spark Place, P. Tuazon Avenue cor. 10th Avenue, Araneta City, Cubao, Quezon City 1109, Philippines</span>
          </a>
          <a href="tel:+639602778783" class="flex items-center gap-2 hover:text-coral transition-colors">
            <svg class="w-4 h-4 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
            <span>+63 960 277 8783</span>
          </a>
          <a href="mailto:info@lorolabs.ai" class="flex items-center gap-2 hover:text-coral transition-colors">
            <svg class="w-4 h-4 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
            <span>info@lorolabs.ai</span>
          </a>
        </div>
        <a href="#contact" class="inline-block mt-6 bg-coral text-white px-6 py-3 rounded-full text-sm font-semibold hover:bg-coral-dark transition-colors uppercase tracking-wider">
          Get Quote
        </a>
      </div>
    </div>

    <!-- Bottom Bar -->
    <div class="border-t border-white/10 pt-8 flex flex-col md:flex-row items-center justify-between gap-4">
      <p class="text-white/40 text-sm">&copy; {currentYear} Loro Labs. All rights reserved.</p>
      <p class="text-white/40 text-sm hidden md:block">"We build with empathy, creativity, and purpose."</p>
      <div class="flex gap-6 text-sm text-white/40">
        <a href="/privacy-policy" class="hover:text-white transition-colors">Privacy</a>
        <a href="/terms-and-conditions" class="hover:text-white transition-colors">Terms</a>
      </div>
    </div>
  </div>
</footer>