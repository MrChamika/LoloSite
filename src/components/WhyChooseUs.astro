---
// Why Choose Us Section
const features = [
  {
    title: 'We Learn Your Business First',
    desc: 'Before we write a line of code, we sit with you. We ask the questions most agencies skip. We figure out what actually matters to your operations, not just what looks good on a homepage.',
    icon: `<svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z"/></svg>`,
    color: 'coral',
  },
  {
    title: 'One Team. One Conversation.',
    desc: 'No account managers relaying messages. No ticket systems. No waiting three days for a reply. You talk directly to the people building your project. Every time.',
    icon: `<svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"/></svg>`,
    color: 'teal',
  },
  {
    title: 'Honest Scoping. Not Upselling.',
    desc: 'Sometimes the answer is a simple website. Sometimes it is a full platform. We will be honest about which one, even when the simple answer means a smaller invoice for us.',
    icon: `<svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/></svg>`,
    color: 'gold',
  },
  {
    title: 'It Works After We Leave',
    desc: 'We do not build things that fall apart when the contract ends. You own everything. You understand everything. And if you need us later, we are here.',
    icon: `<svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M5 3v4M3 5h4M6 17v4m-2-2h4m5-16l2.286 6.857L21 12l-5.714 2.143L13 21l-2.286-6.857L5 12l5.714-2.143L13 3z"/></svg>`,
    color: 'coral',
  },
];
---

<section id="why" class="py-24 md:py-32 bg-warm-50">
  <div class="max-w-7xl mx-auto px-6 md:px-12">
    <div class="text-center mb-16 css-reveal">
      <p class="text-sm font-accent text-coral tracking-widest uppercase mb-2">The Loro Difference</p>
      <h2 class="text-3xl md:text-4xl font-heading font-bold text-warm-800 mb-4">Why It Matters for Your Business</h2>
      <p class="text-warm-600 max-w-2xl mx-auto">
        The technology behind your product isn't just a detail. It's the difference between a site that works and one that wins.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
      {features.map((feature, i) => (
        <div class="group bg-white rounded-3xl p-8 border border-warm-100 hover:border-coral/30 hover:shadow-xl transition-all css-reveal" style={`transition-delay: ${i * 100}ms`}>
          <div class={`w-14 h-14 rounded-2xl flex items-center justify-center mb-6 ${
            feature.color === 'coral' ? 'bg-coral/10 text-coral' :
            feature.color === 'teal' ? 'bg-teal/10 text-teal' :
            'bg-gold/10 text-gold'
          } group-hover:scale-110 transition-transform`}>
            <Fragment set:html={feature.icon} />
          </div>
          <h3 class="text-xl font-heading font-bold text-warm-800 mb-3">{feature.title}</h3>
          <p class="text-warm-600 leading-relaxed">{feature.desc}</p>
        </div>
      ))}
    </div>
  </div>
</section>
