---
// Hero Section with Ken Burns image and staggered text reveal
---

<section id="hero" class="relative min-h-[85vh] sm:min-h-[90vh] mx-2 sm:mx-4 md:mx-6 mt-4 rounded-2xl md:rounded-3xl flex items-center overflow-hidden">
  <!-- Background Image with Ken Burns -->
  <div class="absolute inset-0 hero-image-wrapper">
    <picture>
      <source media="(max-width: 639px)" srcset={`${import.meta.env.BASE_URL}/hero-elearning-mobile-600.webp`} />
      <source media="(min-width: 640px)" srcset={`${import.meta.env.BASE_URL}/hero-elearning-desktop.webp`} />
      <img
        src={`${import.meta.env.BASE_URL}/hero-elearning-desktop.jpg`}
        alt="Loro Labs design engineering studio"
        class="hero-image w-full h-full object-cover object-center"
        loading="eager"
        fetchpriority="high"
      />
    </picture>
    <div class="absolute inset-0 bg-gradient-to-r from-warm-900/95 via-warm-900/80 to-warm-900/40"></div>
    <div class="absolute inset-0 bg-gradient-to-t from-warm-900/60 via-transparent to-transparent"></div>
  </div>

  <!-- Content -->
  <div class="relative z-10 max-w-7xl mx-auto px-5 sm:px-6 md:px-12 py-20 sm:py-32 md:py-40">
    <div class="max-w-3xl">
      <!-- Logo -->
      <div class="hero-logo mb-6 sm:mb-8">
        <img src={`${import.meta.env.BASE_URL}/loro-icon-white.svg`} alt="Loro Labs" class="w-12 h-12 sm:w-16 sm:h-16" />
      </div>

      <!-- Heading -->
      <h1 class="text-3xl sm:text-4xl md:text-6xl lg:text-7xl font-heading font-bold text-white leading-tight mb-4 sm:mb-6">
        <span class="hero-line block overflow-hidden">
          <span class="hero-line-inner block">Design engineering</span>
        </span>
        <span class="hero-line block overflow-hidden">
          <span class="hero-line-inner block">for ambitious brands.</span>
        </span>
      </h1>

      <!-- Subtitle -->
      <p class="hero-subtitle text-base sm:text-lg md:text-xl text-white/80 max-w-xl mb-4 font-body">
        We design and build custom websites, portals, and apps with uncompromised performance. From the Philippines to ambitious brands across Asia-Pacific.
      </p>

      <!-- Tagline -->
      <p class="hero-tagline text-xs sm:text-sm text-white/60 mb-6 sm:mb-8 font-accent tracking-wide">
        Tech crafted with empathy &middot; Purpose in every pixel
      </p>

      <!-- Buttons -->
      <div class="flex flex-col sm:flex-row gap-3 sm:gap-4">
        <a href="#pricing" class="hero-btn inline-flex items-center justify-center gap-2 bg-white text-warm-800 px-6 sm:px-8 py-3 sm:py-4 rounded-full font-semibold hover:bg-white/90 transition-colors text-base sm:text-lg">
          View Packages
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
          </svg>
        </a>
        <a href="#portfolio" class="hero-btn inline-flex items-center justify-center gap-2 bg-white/10 backdrop-blur-sm text-white px-6 sm:px-8 py-3 sm:py-4 rounded-full font-semibold hover:bg-white/20 transition-colors text-base sm:text-lg border border-white/20">
          See Our Work
        </a>
      </div>
    </div>
  </div>

  <!-- Scroll indicator -->
  <div class="absolute bottom-6 sm:bottom-8 left-1/2 -translate-x-1/2 z-10 hidden md:flex flex-col items-center gap-2 animate-bounce-gentle">
    <span class="text-white/50 text-xs font-accent tracking-widest uppercase">Scroll</span>
    <svg class="w-5 h-5 text-white/50" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3"/>
    </svg>
  </div>
</section>