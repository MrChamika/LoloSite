---
// Industry Showcase Section
const industries = [
  { name: 'Wellness & Clinics', category: 'Health & Spa', color: 'from-pink-500/20 to-rose-500/20' },
  { name: 'Hair Salons & Stylists', category: 'Beauty', color: 'from-purple-500/20 to-violet-500/20' },
  { name: 'Talent & Staffing', category: 'Recruitment', color: 'from-blue-500/20 to-indigo-500/20' },
  { name: 'Schools & Education', category: 'Education', color: 'from-green-500/20 to-emerald-500/20' },
  { name: 'Cosmetics & Beauty', category: 'E-Commerce', color: 'from-fuchsia-500/20 to-pink-500/20' },
  { name: 'Dealers & Services', category: 'Automotive', color: 'from-orange-500/20 to-amber-500/20' },
  { name: 'Mobility & Connectivity', category: 'Travel & Telecom', color: 'from-cyan-500/20 to-teal-500/20' },
  { name: 'Build & Trades', category: 'Construction', color: 'from-yellow-500/20 to-orange-500/20' },
  { name: 'Products & Platforms', category: 'Software & Tech', color: 'from-coral/20 to-gold/20' },
];
---

<section class="py-24 md:py-32 bg-warm-50">
  <div class="max-w-7xl mx-auto px-6 md:px-12">
    <div class="text-center mb-16 css-reveal">
      <p class="text-sm font-accent text-coral tracking-widest uppercase mb-2">Industries</p>
      <h2 class="text-3xl md:text-4xl font-heading font-bold text-warm-800 mb-4">Built for every business</h2>
      <p class="text-warm-600 max-w-2xl mx-auto">
        Real projects for real businesses, from healthcare to e-commerce and everything in between.
      </p>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
      {industries.map((industry, i) => (
        <div class="industry-card group relative overflow-hidden rounded-3xl bg-white border border-warm-100 p-6 cursor-pointer css-reveal" style={`transition-delay: ${i * 60}ms`}>
          <!-- Gradient Background -->
          <div class={`absolute inset-0 bg-gradient-to-br ${industry.color} opacity-0 group-hover:opacity-100 transition-opacity duration-500`}></div>
          
          <!-- Content -->
          <div class="relative z-10">
            <p class="text-xs font-accent text-coral tracking-widest uppercase mb-2">{industry.category}</p>
            <h3 class="text-lg font-heading font-bold text-warm-800 group-hover:text-warm-900">{industry.name}</h3>
          </div>

          <!-- Decorative Icon -->
          <div class="absolute bottom-4 right-4 w-12 h-12 rounded-xl bg-warm-50 group-hover:bg-white/80 flex items-center justify-center transition-colors">
            <svg class="w-6 h-6 text-warm-400 group-hover:text-coral transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M13 7l5 5m0 0l-5 5m5-5H6"/>
            </svg>
          </div>
        </div>
      ))}
    </div>

    <div class="text-center mt-12 css-reveal">
      <a href="#portfolio" class="inline-flex items-center gap-2 text-coral font-accent font-semibold hover:gap-3 transition-all">
        View full portfolio
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/>
        </svg>
      </a>
    </div>
  </div>
</section>
