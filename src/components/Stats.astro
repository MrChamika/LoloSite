---
// Stats Counter Section
const stats = [
  { value: 50, suffix: '+', label: 'projects delivered for ambitious APAC teams' },
  { value: 10, suffix: '+', label: 'industries served across web, app, and AI media' },
  { value: 100, suffix: '%', label: 'projects delivered by our in-house team' },
];
---

<section class="py-20 bg-white">
  <div class="max-w-7xl mx-auto px-6 md:px-12">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      {stats.map((stat, i) => (
        <div class="stat-card text-center p-8 rounded-3xl bg-warm-50 border border-warm-100 css-reveal" style={`transition-delay: ${i * 100}ms`}>
          <div class="stat-number text-5xl md:text-6xl font-heading font-bold text-warm-800 mb-2" data-target={stat.value} data-suffix={stat.suffix}>
            0{stat.suffix}
          </div>
          <p class="text-warm-600 text-sm leading-relaxed">{stat.label}</p>
        </div>
      ))}
    </div>
  </div>
</section>